apiVersion: v1
kind: ConfigMap
metadata:
  name: minimal-site
  namespace: starfleet
data:
  index.html: |
    capstone-version=v1
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: minimal-web
  namespace: starfleet
spec:
  replicas: 1
  selector:
    matchLabels:
      app: minimal-web
  template:
    metadata:
      labels:
        app: minimal-web
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
      - name: web
        image: docker.io/library/busybox@sha256:<DIGEST>
        imagePullPolicy: IfNotPresent
        command:
        - httpd
        - -f
        - -p
        - '8080'
        - -h
        - /site
        ports:
        - name: http
          containerPort: 8080
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
          capabilities:
            drop:
            - ALL
        resources:
          requests:
            cpu: 10m
            memory: 16Mi
          limits:
            memory: 64Mi
        volumeMounts:
        - name: site
          mountPath: /site
          readOnly: true
      volumes:
      - name: site
        configMap:
          name: minimal-site
---
apiVersion: v1
kind: Service
metadata:
  name: minimal-web
  namespace: starfleet
spec:
  selector:
    app: minimal-web
  ports:
  - name: http
    port: 80
    targetPort: http
