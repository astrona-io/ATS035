{
  "context": "kind-astro-ats-035-capstone-010",
  "resources": [
    {
      "kind": "configmap",
      "name": "minimal-site",
      "namespace": "starfleet",
      "expected": {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
          "name": "minimal-site",
          "namespace": "starfleet"
        },
        "data": {
          "index.html": "capstone-version=v1\n"
        }
      }
    },
    {
      "kind": "deployment",
      "name": "minimal-web",
      "namespace": "starfleet",
      "expected": {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "minimal-web",
          "namespace": "starfleet"
        },
        "spec": {
          "replicas": 1,
          "template": {
            "metadata": {
              "labels": {
                "app": "minimal-web"
              }
            },
            "spec": {
              "securityContext": {
                "runAsNonRoot": true,
                "runAsUser": 10001,
                "seccompProfile": {
                  "type": "RuntimeDefault"
                }
