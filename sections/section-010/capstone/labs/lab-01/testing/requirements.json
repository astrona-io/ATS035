              "containers": [
                {
                  "name": "web",
                  "imagePullPolicy": "IfNotPresent",
                  "command": [
                    "httpd",
                    "-f",
                    "-p",
                    "8080",
                    "-h",
                    "/site"
                  ],
                  "securityContext": {
                    "allowPrivilegeEscalation": false,
                    "readOnlyRootFilesystem": true,
                    "capabilities": {
                      "drop": [
                        "ALL"
                      ]
                    }
                  },
                  "resources": {
                    "limits": {
                      "memory": "64Mi"
                    }
                  },
                  "volumeMounts": [
                    {
                      "name": "site",
                      "mountPath": "/site",
                      "readOnly": true
